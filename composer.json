{
    "name": "justimmo/php-sdk",
    "description": "PHP-SDK for the JUSTIMMO API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Justimmo\\": "src/Justimmo"
        }
    },
    "autoload-dev": {
        "psr-0": {
            "Justimmo": "tests/"
        }
    }
}
