{
    "name": "justimmo/php-sdk",
    "description": "PHP-SDK for the JUSTIMMO API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^6.5|^7.5|^8.5"
    },
    "autoload": {
        "psr-4": { "Justimmo\\": "src/Justimmo" }
    },
    "autoload-dev": {
        "psr-4": {
            "Justimmo\\Tests\\": "tests/Justimmo/Tests"
        }
    }
}
